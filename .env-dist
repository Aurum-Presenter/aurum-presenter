# Copy to .env and fill in the two keys before the first `docker compose up`.
#
#   APP_SIGNING_KEY  signs stateless access tokens, keys refresh-token and recovery-code hashes
#   APP_SECRET_KEY   32 raw bytes, base64, for AES-256-GCM over TOTP secrets
#
# Generate both:
#   openssl rand -hex 32      -> APP_SIGNING_KEY
#   openssl rand -base64 32   -> APP_SECRET_KEY

APP_ENV=development
API_PORT=8080

# The stage-pairing signalling relay. SDP and ICE only; it never sees session content.
SIGNAL_PORT=8081

APP_SIGNING_KEY=
APP_SECRET_KEY=

# The refresh cookie is only marked Secure over HTTPS; local development is plain HTTP.
AUTH_COOKIE_SECURE=false

# The container serves the app and the API from one origin, so this list only matters while the
# client is being worked on against Trunk's own dev server.
CORS_ALLOWED_ORIGINS=http://localhost:4174,http://127.0.0.1:4174

S3_BUCKET=aurum-sheets
MINIO_ROOT_USER=aurum
MINIO_ROOT_PASSWORD=aurum-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MAIL_UI_PORT=8025
