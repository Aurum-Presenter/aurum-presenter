<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Aurum">
            <directory>test</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="test"/>
        <!-- Each test run gets its own throwaway database directory. -->
        <env name="DATA_DIR" value="var/test-data"/>
        <env name="APP_SIGNING_KEY" value="test-signing-key"/>
        <env name="APP_SECRET_KEY" value="MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMD0="/>
        <env name="AUTH_COOKIE_SECURE" value="false"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
