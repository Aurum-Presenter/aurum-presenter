# Dependencies are installed inside the image from composer.lock, so copying the host's
# vendor/ in would both bloat the build context and risk shipping platform-specific builds.
vendor/

# The databases. Never bake a developer's control.sqlite or workspace files into an image.
var/
data/cache/

# Local config overrides; the container is configured by environment variables.
config/autoload/*.local.php
.env
.env.*

.git/
.phpunit.cache/
.phpunit.result.cache
