{
    "name": "aurum-presenter/backend",
    "description": "Aurum Presenter API — Mezzio on SQLite, one database file per workspace",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "aws/aws-sdk-php": "^3.336",
        "doctrine/dbal": "^4.2",
        "laminas/laminas-cli": "^1.10",
        "laminas/laminas-config-aggregator": "^1.17",
        "laminas/laminas-di": "^3.14",
        "laminas/laminas-diactoros": "^3.5",
        "laminas/laminas-httphandlerrunner": "^2.11",
        "laminas/laminas-permissions-rbac": "^3.6",
        "laminas/laminas-servicemanager": "^3.23",
        "mezzio/mezzio": "^3.20",
        "mezzio/mezzio-helpers": "^5.17",
        "mezzio/mezzio-laminasrouter": "^3.9",
        "ramsey/uuid": "^4.7",
        "spomky-labs/otphp": "^11.3",
        "symfony/mailer": "^7.2",
        "tempest/discovery": "^1.0",
        "tempest/reflection": "^1.0",
        "tempest/support": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppTest\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "laminas/laminas-component-installer": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "stan": "phpstan analyse"
    }
}
